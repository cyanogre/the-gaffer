{
  "name": "the-gaffer",
  "private": true,
  "version": "0.1.0",
  "description": "The Gaffer: simulador de míster con escenarios 3D y personajes en pixel art. Móvil y PC.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:artifact": "vite build && node scripts/build-artifact.mjs",
    "bake:sprites": "vite build --ssr scripts/bake-sprites.ts --outDir .bake --emptyOutDir && node .bake/bake-sprites.js"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
